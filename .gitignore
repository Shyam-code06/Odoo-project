# ==============================================================================
# Environment Variables & Secrets (CRITICAL)
# ==============================================================================
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example environment file to be tracked
!.env.example
!server/.env.example
!client/.env.example

# ==============================================================================
# Dependencies
# ==============================================================================
node_modules/
*/node_modules/
jspm_packages/
web_modules/

